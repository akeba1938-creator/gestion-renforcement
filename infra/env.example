# Modèle de variables d'environnement pour le développement local.
# Copier en infra/.env (ignoré par Git) et remplacer chaque valeur.
# Ne jamais committer de valeurs réelles.

# PostgreSQL (docker compose)
POSTGRES_PASSWORD=a-remplacer
ECOLE_APP_DB_PASSWORD=a-remplacer

# Backend (profil dev)
# Compte de migration Flyway (propriétaire du schéma)
DB_MIGRATION_USERNAME=ecole
DB_MIGRATION_PASSWORD=a-remplacer-identique-a-POSTGRES_PASSWORD
# Compte applicatif soumis à la RLS
DB_USERNAME=ecole_app_login
DB_PASSWORD=a-remplacer-identique-a-ECOLE_APP_DB_PASSWORD

# Clé HMAC des JWT (HS256) : au moins 32 octets aléatoires encodés en Base64
# Exemple de génération : openssl rand -base64 48
APP_JWT_SECRET=a-remplacer
# Clé AES-256 de chiffrement des secrets TOTP : exactement 32 octets encodés en Base64
# Exemple de génération : openssl rand -base64 32
APP_MFA_ENCRYPTION_KEY=a-remplacer
